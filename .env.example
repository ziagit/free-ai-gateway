# --- Protect your gateway (strongly recommended if deployed publicly) ---
# Your apps send:  Authorization: Bearer <GATEWAY_API_KEY>
GATEWAY_API_KEY=change-me-to-a-long-random-string

# --- Provider keys: fill in any you have. Empty = skipped. ---
# Order below is the default fallback order.
GEMINI_API_KEY=
# ^ https://aistudio.google.com/apikey
GROQ_API_KEY=
# ^ https://console.groq.com/keys
OPENROUTER_API_KEY=
# ^ https://openrouter.ai/keys
CLOUDFLARE_ACCOUNT_ID=
# ^ https://dash.cloudflare.com  (Account ID on overview page)
CLOUDFLARE_API_TOKEN=
# ^   + API token with "Workers AI" permission
SAMBANOVA_API_KEY=
# ^ https://cloud.sambanova.ai
NVIDIA_API_KEY=
# ^ https://build.nvidia.com
ZAI_API_KEY=
# ^ https://z.ai
MISTRAL_API_KEY=
# ^ https://console.mistral.ai
COHERE_API_KEY=
# ^ https://dashboard.cohere.com
HF_TOKEN=
# ^ https://huggingface.co/settings/tokens

# --- Optional ---
# PROVIDER_ORDER=groq,gemini,openrouter,nvidia,zai,cloudflare,sambanova,mistral,cohere,huggingface
# Override any provider's model:  <NAME>_MODEL=...
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Cooldowns in seconds
# MINUTE_COOLDOWN=60      # after a per-minute 429
# DAILY_COOLDOWN=3600     # after a daily-limit 429 / out of credits (retries hourly)
# ERROR_COOLDOWN=30       # after 5xx / timeout
# AUTH_COOLDOWN=21600     # after 401/403 (bad key)
# REQUEST_TIMEOUT=60
# CORS_ORIGINS=*
